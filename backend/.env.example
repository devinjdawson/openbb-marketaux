# Marketaux API token (free at https://www.marketaux.com/register)
MARKETAUX_API_TOKEN=

# Comma separated default watchlist used for sentiment widgets
DEFAULT_SYMBOLS=AAPL,MSFT,AMZN,GOOGL,TSLA,NVDA,META

# How many days of news the sentiment widgets look back by default
SENTIMENT_DAYS=7

# Bayesian prior added when normalising the bucketed sentiment score
BAYESIAN_EXTRA_VALUES=100

# Cache TTLs in seconds (Marketaux free plan = 100 requests/day, cache aggressively)
CACHE_TTL_NEWS=120
CACHE_TTL_SENTIMENT=900
CACHE_TTL_YAHOO_QUOTES=60
CACHE_TTL_YAHOO_HISTORY=300
